{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "demo-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--outDir",
        ".",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    },
    {
      "name": "netlify",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "netlify",
        "dev",
        "--offline",
        "--no-open"
      ],
      "port": 8899,
      "autoPort": false,
      "env": {
        "BROWSER": "none",
        "NETLIFY_TELEMETRY_DISABLED": "1"
      }
    }
  ]
}